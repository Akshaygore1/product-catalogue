# Copy to .env to override. Every value has a working default for `docker compose up`.

# --- Host ports for docker compose (change if already in use) ---
WEB_PORT=8080
MAILPIT_PORT=8025

# --- API ---
PORT=3000
# Leave unset for Compose (one trusted nginx hop) or direct development access (no proxy).
TRUST_PROXY=
LOG_LEVEL=info
# Comma-separated origins allowed to call the API directly (only needed when not behind the nginx proxy)
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app, used for product links in enquiry emails
WEB_BASE_URL=http://localhost:8080

# Product data source adapter (only "fakestore" today)
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
CATALOGUE_CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=5000

# Curated "top rated" products (JSON file of product IDs)
FEATURED_PRODUCTS_FILE=./data/featured.json

# --- Email (any SMTP server; Mailpit locally, e.g. AWS SES SMTP in production) ---
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Catalogue <no-reply@catalogue.local>"
SALES_INBOX=sales@catalogue.local
